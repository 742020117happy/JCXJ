{
    // ========== CMake Tools 配置 ==========
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.generator": "Unix Makefiles",
    "cmake.configureArgs": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_CUDA_ARCHITECTURES=120",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
    ],
    "cmake.buildArgs": [
        "-j$(nproc)"
    ],
    "cmake.configureOnOpen": true,
    "cmake.configureOnEdit": false,
    "cmake.clearOutputBeforeBuild": true,
    "cmake.loggingLevel": "debug",
    "cmake.showOptionsMovedNotification": false,
    "cmake.statusbar.visibility": "visible",
    "cmake.statusbar.advanced": {
        "debug": {
            "visibility": "hidden"
        },
        "launch": {
            "visibility": "hidden"
        },
        "build": {
            "visibility": "visible"
        },
        "buildTarget": {
            "visibility": "visible"
        },
        "ctest": {
            "visibility": "hidden"
        }
    },
    "cmake.environment": {
        "PATH": "/usr/local/cuda-13.0/bin:/usr/lib/qt5/bin:${env:PATH}",
        "LD_LIBRARY_PATH": "/usr/local/cuda-13.0/lib64:/opt/hikvision_sdk_arm64/MakeAll:/opt/hikvision_sdk_arm64/MakeAll/HCNetSDKCom:${env:LD_LIBRARY_PATH}",
        "OPENSSL_CONF": "/opt/hikvision_sdk_arm64/openssl.cnf"
    },
    "cmake.copyCompileCommands": "${workspaceFolder}/compile_commands.json",
    // ========== C/C++ 扩展配置 ==========
    "C_Cpp.default.configurationProvider": "ms-vscode.cmake-tools",
    "C_Cpp.intelliSenseEngine": "default",
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.autocomplete": "default",
    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4 }",
    "C_Cpp.dimInactiveRegions": true,
    "C_Cpp.enhancedColorization": "enabled",
    "C_Cpp.suggestSnippets": true,
    "C_Cpp.default.cppStandard": "c++17",
    "C_Cpp.default.cStandard": "c11",
    "C_Cpp.default.includePath": [
        "${workspaceFolder}/**",
        "/usr/local/cuda-13.0/include",
        "/opt/hikvision_sdk_arm64/incCn"
    ],
    "C_Cpp.default.defines": [
        "QT_CORE_LIB",
        "QT_GUI_LIB",
        "QT_WIDGETS_LIB",
        "LINUX_DEFINE",
        "_LINUX_",
        "HC_NET_SDK",
        "CUDA_VERSION=13.0",
        "NDEBUG"
    ],
    // ========== 通用设置 ==========
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/*.pyc": true,
        "**/__pycache__": true,
        "**/*.so": true,
        "**/*.a": true,
        "**/build": false
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "build/**": true,
        "**/*.log": true
    },
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.encoding": "utf8",
    "files.autoGuessEncoding": true,
    // ========== 终端设置 ==========
    "terminal.integrated.env.linux": {
        "PATH": "/usr/local/cuda-13.0/bin:/usr/lib/qt5/bin:${env:PATH}",
        "LD_LIBRARY_PATH": "/usr/local/cuda-13.0/lib64:/opt/hikvision_sdk_arm64/MakeAll:/opt/hikvision_sdk_arm64/MakeAll/HCNetSDKCom:${env:LD_LIBRARY_PATH}",
        "OPENSSL_CONF": "/opt/hikvision_sdk_arm64/openssl.cnf",
        "QT_SELECT": "5",
        "QT_QPA_PLATFORM": "xcb"
    },
    "terminal.integrated.defaultProfile.linux": "bash",
    "cSpell.words": [
        "libhcnetsdk"
    ]
}