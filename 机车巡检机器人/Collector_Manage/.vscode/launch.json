    "version": "0.2.0",
    "configurations": [
        {
            "name": "🐛 Debug Collector_Manage",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/collector_manage",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build/bin",
