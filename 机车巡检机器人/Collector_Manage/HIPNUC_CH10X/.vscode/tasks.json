{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "cmake: build collector_manage",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "collector_manage",
                "--", "-j", "${execCommand:echo $(( $(nproc) > 4 ? 4 : $(nproc) ))}"
            ],
            "dependsOn": "cmake: configure",
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "cmake: build hipnuc_ch10x_manage",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build",
                "--target", "hipnuc_ch10x_manage",
                "--", "-j", "4"
            ],
            "dependsOn": "cmake: configure",
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "cmake: clean",
            "type": "shell",
            "command": "rm",
            "args": ["-rf", "${workspaceFolder}/build"],
            "problemMatcher": []
        }
    ]
}