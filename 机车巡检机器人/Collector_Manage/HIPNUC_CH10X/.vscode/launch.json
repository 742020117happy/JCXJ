{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch collector_manage",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/collector_manage",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/build",
            "environment": [
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/usr/local/cuda-13.0/lib64:/opt/hikvision_sdk_arm64/MakeAll:/opt/hikvision_sdk_arm64/MakeAll/HCNetSDKCom:${env:LD_LIBRARY_PATH}"
                },
                {
                    "name": "QT_QPA_PLATFORM",
                    "value": "xcb"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake: build collector_manage",
            "visualizerFile": "/home/nvidia/.config/Code/User/workspaceStorage/4beaa872a92c4efef40e7b3b4a46928c/tonka3000.qtvsctools/qt.natvis.xml"
        },
